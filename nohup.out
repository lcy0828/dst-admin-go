over":"开放节日特供的食谱。让你能随时随地烹饪节日料理，享受吧！","name":"FestivalRecipes","label":"解禁节日料理","default":false,"options":[{"description":"是","data":true},{"description":"否(默认)","data":false}]},{"hover":"优化食谱的介绍界面和信息展示（仅支持中文环境）。这面甜得掉牙了，大叔。","name":"BetterCookBook","label":"优化食谱介绍","default":true,"options":[{"description":"是(默认)","data":true},{"description":"否","data":false}]},{"default":"","options":[{"description":"","data":""}],"name":"Title","label":""},{"default":"","options":[{"description":"","data":""}],"name":"Title","label":"祈雨祭"},{"hover":"允许添加\"祈雨祭\"的内容。不管是阴还是晴，都是祈求自然而受的恩惠。","name":"PrayForRain","label":"开启\"祈雨祭\"","default":true,"options":[{"description":"是","data":true},{"description":"否","data":false}]},{"hover":"设置《多变的云》的制作栏。决定一本巨著的沉沦或现世。","name":"BookRecipetabs","label":"《多变的云》制作方式","default":"bookbuilder","options":[{"description":"书籍栏(默认)","data":"bookbuilder"},{"description":"魔法栏","data":"magic"}]},{"hover":"设置月轮宝盘的升级次数的最大值。","name":"RevolvedUpdateTimes","label":"月轮宝盘最大升级次数","default":20,"options":[{"description":"4次","data":4},{"description":"8次","data":8},{"description":"12次","data":12},{"description":"16次","data":16},{"description":"20次(默认)","data":20},{"description":"24次","data":24},{"description":"30次","data":30},{"description":"40次","data":40}]},{"default":"","options":[{"description":"","data":""}],"name":"Title","label":""},{"default":"","options":[{"description":"","data":""}],"name":"Title","label":"丰饶传说"},{"hover":"允许添加\"丰饶传说\"的内容。如果有一天我能够拥有一个大果园，我愿放下所有追求做个农夫去种田。","name":"LegendOfFall","label":"开启\"丰饶传说\"","default":true,"options":[{"description":"是","data":true},{"description":"否","data":false}]},{"hover":"设置异种作物过熟的时间。果子熟透了就要掉地上，自然规律真奇妙。","name":"OverripeTime","label":"异种作物过熟时间","default":1,"options":[{"description":"1倍(默认)","data":1},{"description":"2倍","data":2},{"description":"3倍","data":3},{"description":"不过熟","data":0}]},{"hover":"设置异种作物害虫产生几率。种好你的田，管好你的地！","name":"PestRisk","label":"异种作物虫害率","default":0.007,"options":[{"description":"不产生","data":0},{"description":"0.07%","data":0.0007},{"description":"0.2%","data":0.002},{"description":"0.7%(默认)","data":0.007},{"description":"1.2%","data":0.012},{"description":"2.0%","data":0.02},{"description":"10.0%","data":0.1},{"description":"总是产生","data":1}]},{"hover":"设置子圭玄鸟再生的所需时间。生死是个循环！","name":"PhoenixRebirthCycle","label":"玄鸟重生周期","default":7200,"options":[{"description":"5秒","data":5},{"description":"1天","data":480},{"description":"5天","data":2400},{"description":"10天","data":4800},{"description":"15天(默认)","data":7200},{"description":"20天","data":9600},{"description":"25天","data":12000},{"description":"30天","data":14400}]},{"hover":"设置子圭玄鸟BOSS战的难度。谁是战斗之王，我是手残之王。","name":"PhoenixBattleDifficulty","label":"玄鸟战斗难度","default":2,"options":[{"description":"小菜一碟","data":1},{"description":"普普通通(默认)","data":2},{"description":"步履艰难","data":3}]},{"hover":"设置子圭突触的贴图。你要是对它密集恐惧症犯了就换成官方的图吧。","name":"SivingRootTex","label":"子圭突触贴图","default":1,"options":[{"description":"mod贴图(默认)","data":1},{"description":"官方图","data":2}]},{"hover":"设置子圭玄鸟正羽的攻击力和耗血。变态，还是不变态，你自己界定！","name":"SivFeaStrength","label":"子圭玄鸟正羽强度","default":3,"options":[{"description":"17\/-0.5","data":1},{"description":"23.8\/-1","data":2},{"description":"34\/-2(默认)","data":3},{"description":"42.5\/-2.5","data":4},{"description":"51\/-3","data":5},{"description":"61.2\/-4","data":6},{"description":"68\/-4.5","data":7}]},{"default":"","options":[{"description":"","data":""}],"name":"Title","label":""},{"default":"","options":[{"description":"","data":""}],"name":"Title","label":"电闪雷鸣"},{"hover":"允许添加\"电闪雷鸣\"的内容。电气的力量带来了科技的发展。","name":"FlashAndCrush","label":"开启\"电闪雷鸣\"","default":true,"options":[{"description":"是","data":true},{"description":"否","data":false}]},{"hover":"设置解锁重铸科技的方式。请偷偷的告诉我，你怎么学会的。","name":"TechUnlock","label":"[重铸科技]解锁方式","default":"prototyper","options":[{"description":"Boss掉落蓝图","data":"lootdropper"},{"description":"电气重铸台(默认)","data":"prototyper"}]},{"default":"","options":[{"description":"","data":""}],"name":"Title","label":""},{"default":"","options":[{"description":"","data":""}],"name":"Title","label":"尘市蜃楼"},{"hover":"允许添加\"尘市蜃楼\"的内容。黄沙之中，有座幻影般的古城和悲惨的命运。","name":"DesertSecret","label":"开启\"尘市蜃楼\"","default":true,"options":[{"description":"是","data":true},{"description":"否","data":false}]},{"hover":"是否启用幻化机制。沉迷幻想是件好事吗。","name":"DressUp","label":"启用幻化机制","default":true,"options":[{"description":"是","data":true},{"description":"否","data":false}]},{"default":"","options":[{"description":"","data":""}],"name":"Title","label":""},{"default":"","options":[{"description":"","data":""}],"name":"Title","label":"其他"},{"hover":"自动清除掉在地上的臭东西(大便、鸟粪、腐烂物)。化作春泥更护花。","name":"CleaningUpStench","label":"臭臭自动清理","default":false,"options":[{"description":"是","data":true},{"description":"否(默认)","data":false}]},{"hover":"设置靠背熊的掉落几率。又萌又懒又喜欢吃的小宠物谁不爱呢？","name":"BackCubChance","label":"靠背熊掉落几率","default":0.7,"options":[{"description":"总是掉落","data":1},{"description":"85%","data":0.85},{"description":"70%(默认)","data":0.7},{"description":"55%","data":0.55},{"description":"40%","data":0.4},{"description":"25%","data":0.25},{"description":"10%","data":0.1},{"description":"不会掉落","data":0}]}], "icon": "modicon.tex", "version": "7.1.3", "client_only_mod": false, "forumthread": "https://www.zybuluo.com/Tout/note/1509031", "all_clients_require_mod": true, "api_version": 10, "description": "感谢订阅本mod！                                    [版本]7.1.3  [文件]1392778117\n\n*如你所见，本mod包括了作者的很多的脑洞，我也很想把这个mod做成像DLC一样的规模，敬请期待吧。\n*本mod为个人爱好所做，禁止任何个人或组织转载、除自用外的修改、发布或其他形式的侵犯本mod权益的行为！\n\n特别感谢：半夏微暖半夏凉(代码指导)、羽中就是他(客串画佬)、风铃草(特功支持)、白饭(百科编辑)", "reign_of_giants_compatible": false, "dst_compatible": true, "locale": "zh", "icon_atlas": "modicon.xml", "name": "[DST] 棱镜", "priority": -345, "author": "ti_Tout", "server_filter_tags": ["棱镜"]}
