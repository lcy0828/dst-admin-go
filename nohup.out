over":"开放节日特供的食谱。让你能随时随地烹饪节日料理，享受吧！","name":"FestivalRecipes","label":"解禁节日料理","default":false,"options":[{"description":"是","data":true},{"description":"否(默认)","data":false}]},{"hover":"优化食谱的介绍界面和信息展示（仅支持中文环境）。这面甜得掉牙了，大叔。","name":"BetterCookBook","label":"优化食谱介绍","default":true,"options":[{"description":"是(默认)","data":true},{"description":"否","data":false}]},{"default":"","options":[{"description":"","data":""}],"name":"Title","label":""},{"default":"","options":[{"description":"","data":""}],"name":"Title","label":"祈雨祭"},{"hover":"允许添加\"祈雨祭\"的内容。不管是阴还是晴，都是祈求自然而受的恩惠。","name":"PrayForRain","label":"开启\"祈雨祭\"","default":true,"options":[{"description":"是","data":true},{"description":"否","data":false}]},{"hover":"设置《多变的云》的制作栏。决定一本巨著的沉沦或现世。","name":"BookRecipetabs","label":"《多变的云》制作方式","default":"bookbuilder","options":[{"description":"书籍栏(默认)","data":"bookbuilder"},{"description":"魔法栏","data":"magic"}]},{"hover":"设置月轮宝盘的升级次数的最大值。","name":"RevolvedUpdateTimes","label":"月轮宝盘最大升级次数","default":20,"options":[{"description":"4次","data":4},{"description":"8次","data":8},{"description":"12次","data":12},{"description":"16次","data":16},{"description":"20次(默认)","data":20},{"description":"24次","data":24},{"description":"30次","data":30},{"description":"40次","data":40}]},{"default":"","options":[{"description":"","data":""}],"name":"Title","label":""},{"default":"","options":[{"description":"","data":""}],"name":"Title","label":"丰饶传说"},{"hover":"允许添加\"丰饶传说\"的内容。如果有一天我能够拥有一个大果园，我愿放下所有追求做个农夫去种田。","name":"LegendOfFall","label":"开启\"丰饶传说\"","default":true,"options":[{"description":"是","data":true},{"description":"否","data":false}]},{"hover":"设置异种作物过熟的时间。果子熟透了就要掉地上，自然规律真奇妙。","name":"OverripeTime","label":"异种作物过熟时间","default":1,"options":[{"description":"1倍(默认)","data":1},{"description":"2倍","data":2},{"description":"3倍","data":3},{"description":"不过熟","data":0}]},{"hover":"设置异种作物害虫产生几率。种好你的田，管好你的地！","name":"PestRisk","label":"异种作物虫害率","default":0.007,"options":[{"description":"不产生","data":