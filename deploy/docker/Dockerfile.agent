# syntax=docker/dockerfile:1.7
FROM golang:1.25-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /out/dst-admin-agent ./agent/cmd/agent \
    && CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /out/dst-map-renderer ./cmd/dst-map-renderer \
    && CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /out/mod-local-setup ./cmd/mod-local-setup

FROM docker:27-cli AS docker_cli

FROM debian:12-slim
ARG DEBIAN_MIRROR=http://deb.debian.org/debian
ARG DEBIAN_SECURITY_MIRROR=http://deb.debian.org/debian-security
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
RUN sed -i \
        -e "s|http://deb.debian.org/debian-security|${DEBIAN_SECURITY_MIRROR}|g" \
        -e "s|http://deb.debian.org/debian|${DEBIAN_MIRROR}|g" \
        /etc/apt/sources.list.d/debian.sources \
    && apt-get update && apt-get install -y --no-install-recommends ca-certificates procps tmux tzdata && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10000 dstagent && useradd --uid 10000 --gid 10000 --no-create-home --shell /usr/sbin/nologin dstagent \
    && install -d -o dstagent -g dstagent -m 0700 /var/lib/dst-admin-agent
COPY --from=build /out/dst-admin-agent /usr/local/bin/dst-admin-agent
COPY --from=build /out/dst-map-renderer /usr/local/bin/dst-map-renderer
COPY --from=build /out/mod-local-setup /usr/local/bin/mod-local-setup
COPY --from=docker_cli /usr/local/bin/docker /usr/local/bin/docker
COPY deploy/docker/config/agent.conf /usr/local/share/dst-admin/agent.conf
COPY deploy/docker/agent-entrypoint.sh /usr/local/bin/agent-entrypoint
USER 10000:10000
WORKDIR /var/lib/dst-admin-agent
ENTRYPOINT ["/usr/local/bin/agent-entrypoint"]
CMD ["/usr/local/bin/dst-admin-agent", "-config", "/var/lib/dst-admin-agent/agent.conf", "-state", "/var/lib/dst-admin-agent/runtime-state.json"]
