# Copy to deploy/docker/.env, then pass --env-file deploy/docker/.env to Compose.
DST_ADMIN_IMAGE=ghcr.io/lcy0828/dst-admin-go/all-in-one:latest
DST_ADMIN_DATA_ROOT=/opt/dst
DST_ADMIN_HTTP_BIND=0.0.0.0:8080
DST_SERVER_PORT_RANGE=10999-11020
DST_AUTH_PORT_RANGE=8766-8790
DST_STEAM_PORT_RANGE=27016-27040
DST_ADMIN_BOOTSTRAP_DST=false
TZ=Asia/Shanghai
