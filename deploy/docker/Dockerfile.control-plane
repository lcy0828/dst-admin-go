# syntax=docker/dockerfile:1.7
FROM --platform=$BUILDPLATFORM node:24-bookworm-slim AS web-build
WORKDIR /src
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM golang:1.25-bookworm AS build
WORKDIR /src
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
COPY --from=web-build /src/dist ./internal/webui/dist
ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_TIME=unknown
ARG FRONTEND_COMMIT=unknown
RUN CGO_ENABLED=1 go build -trimpath -tags webui \
    -ldflags "-s -w -X dont/internal/buildinfo.Version=${VERSION} -X dont/internal/buildinfo.Commit=${COMMIT} -X dont/internal/buildinfo.BuildTime=${BUILD_TIME} -X dont/internal/buildinfo.FrontendCommit=${FRONTEND_COMMIT}" \
    -o /out/dst-admin ./cmd/admin-api

FROM debian:12-slim
ARG TARGETARCH
ARG DEBIAN_MIRROR=http://deb.debian.org/debian
ARG DEBIAN_SECURITY_MIRROR=http://deb.debian.org/debian-security
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
RUN sed -i \
        -e "s|http://deb.debian.org/debian-security|${DEBIAN_SECURITY_MIRROR}|g" \
        -e "s|http://deb.debian.org/debian|${DEBIAN_MIRROR}|g" \
        /etc/apt/sources.list.d/debian.sources \
    && if [ "$TARGETARCH" = "amd64" ]; then \
        dpkg --add-architecture i386; \
        sed -i 's/^Components: main$/Components: main contrib non-free non-free-firmware/' /etc/apt/sources.list.d/debian.sources; \
    fi \
    && apt-get update \
    && if [ "$TARGETARCH" = "amd64" ]; then \
        echo 'steamcmd steam/question select I AGREE' | debconf-set-selections; \
        DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates curl lua5.1 steamcmd tmux tzdata; \
    else \
        DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates curl lua5.1 tmux tzdata; \
    fi \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 dstadmin && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin dstadmin \
    && install -d -o dstadmin -g dstadmin -m 0700 \
        /var/lib/dst-admin \
        /var/lib/dst-admin/backups \
        /var/lib/dst-admin/maps \
        /var/lib/dst-admin/unmanaged-saves \
        /var/lib/dst-admin/unmanaged-server \
        /var/lib/dst-admin/unmanaged-ugc \
        /var/lib/dst-admin/workshop/steamapps/workshop/content/322330
COPY --from=build /out/dst-admin /usr/local/bin/dst-admin
COPY backend/deploy/docker/config/control-plane.conf /usr/local/share/dst-admin/control-plane.conf
COPY backend/deploy/docker/control-plane-entrypoint.sh /usr/local/bin/control-plane-entrypoint
USER 10001:10001
WORKDIR /var/lib/dst-admin
ENV DST_ADMIN_CONFIG=/var/lib/dst-admin/app.conf \
    DST_ADMIN_PACKAGING=control_plane \
    DST_ADMIN_LOCAL_EXECUTOR_ENABLED=false \
    DST_ADMIN_FLEET_CONTROLLER_ENABLED=true \
    DST_ADMIN_FLEET_MEMBER_ENABLED=false \
    HOME=/var/lib/dst-admin
EXPOSE 8000
ENTRYPOINT ["/usr/local/bin/control-plane-entrypoint"]
CMD ["/usr/local/bin/dst-admin", "-addr", "0.0.0.0:8000"]
