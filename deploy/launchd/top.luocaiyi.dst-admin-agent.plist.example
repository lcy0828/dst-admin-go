<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>top.luocaiyi.dst-admin-agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/example/Library/Application Support/DST Admin Agent/bin/dst-admin-agent</string>
    <string>-config</string>
    <string>/Users/example/Library/Application Support/DST Admin Agent/agent.conf</string>
    <string>-state</string>
    <string>/Users/example/Library/Application Support/DST Admin Agent/runtime-state.json</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/example/Library/Logs/DST Admin Agent/agent.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/example/Library/Logs/DST Admin Agent/agent-error.log</string>
</dict>
</plist>
