[Unit]
Description=DST Admin local management service
Documentation=https://github.com/lcy0828/dst-admin-go
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dst
Group=dst
WorkingDirectory=/var/lib/dst-admin
Environment=HOME=/var/lib/dst-admin/home
Environment=DST_ADMIN_CONFIG=/var/lib/dst-admin/app.conf
ExecStart=/usr/local/bin/dst-admin -addr 0.0.0.0:8000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=process
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=false
ProtectSystem=full
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
