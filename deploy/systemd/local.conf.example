RUN_MODE = release
SETUP = incomplete

[server]
HTTP_PORT = 8000
READ_TIMEOUT = 60
WRITE_TIMEOUT = 60
SECURITY_KEY =

[app]
PAGE_SIZE = 20
JWT_SECRET =

[deployment]
PACKAGING = native

[fleet]
LOCAL_EXECUTOR_ENABLED = true
CONTROLLER_ENABLED = false
MEMBER_ENABLED = false
STATE_PATH = /var/lib/dst-admin/fleet
NODE_ID =

[agent]
SERVER_URL =
SECURITY_KEY =

[database]
TYPE = sqlite3
PATH = /var/lib/dst-admin/go-dont.db
TABLE_PREFIX = dont_

[paths]
DST_SAVE_PATH = /srv/dst/saves
DST_BACKUP_PATH = /srv/dst/backups
DST_SERVER_PATH = /srv/dst/server
DST_UGC_PATH = /srv/dst/workshop/steamapps/workshop
DST_MAP_PATH = /srv/dst/maps
DST_SERVER_MODE = 64

[mod]
APP_ID = 322330
STEAM_CMD_PATH = /usr/games/steamcmd
STEAM_WEB_API_KEY =
LUA_BINARY = lua5.1
PYTHON_BINARY = python3
LUA_SH_PATH =
WORKSHOP_MOD_PATH = /srv/dst/workshop
WORKSHOP_CONTENT = /srv/dst/workshop/steamapps/workshop/content/322330

[map]
RENDERER_PATH = /usr/local/bin/dst-map-renderer

[misc]
LOG_LEVEL = info

[backup]
AUTO_BACKUP = true
FREQUENCY = daily
TIME = 10:00
RETENTION = 7
