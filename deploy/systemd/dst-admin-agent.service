[Unit]
Description=DST Admin Agent
Documentation=https://github.com/lcy0828/dst-admin-go
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dst
Group=dst
WorkingDirectory=/var/lib/dst-admin-agent
Environment=HOME=/var/lib/dst-admin-agent/home
EnvironmentFile=-/etc/dst-admin/agent.env
ExecStart=/var/lib/dst-admin-agent/bin/dst-admin-agent -config /var/lib/dst-admin-agent/agent.conf -state /var/lib/dst-admin-agent/runtime-state.json
Restart=on-failure
RestartSec=5
KillMode=process
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=false
ProtectSystem=full
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
