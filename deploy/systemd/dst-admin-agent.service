[Unit]
Description=DST Admin Agent
Documentation=https://github.com/lcy0828/dst-admin-go
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dst
Group=dst
WorkingDirectory=/var/lib/dst-admin-agent
EnvironmentFile=-/etc/dst-admin/agent.env
ExecStart=/usr/local/bin/dst-admin-agent -config /etc/dst-admin/agent.conf -state /var/lib/dst-admin-agent/runtime-state.json
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/dst-admin-agent /srv/dst
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
